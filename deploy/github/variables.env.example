# Non-secret settings -> GitHub repository *variables* (Settings > Secrets and variables > Actions > Variables).
# Copy to variables.env (git-ignored), fill in, then run deploy/github/set-secrets.sh.
AWS_REGION=us-east-1
ECR_BACKEND_REPOSITORY=medical-diagnostics-backend
ECR_FRONTEND_REPOSITORY=medical-diagnostics-frontend
S3_BUCKET_NAME=your-unique-bucket-name
# linux/amd64 for t3/m6i/..., linux/arm64 for Graviton t4g/m7g/...
DOCKER_PLATFORMS=linux/amd64
OPENAI_MODEL=gpt-4o-mini
# Runner selection (JSON). Defaults: CI/build on any self-hosted Linux runner, deploy on the
# runner labelled "production" (the EC2 instance). Use '"ubuntu-latest"' for GitHub-hosted CI.
# CI_RUNS_ON=["self-hosted","linux"]
# DEPLOY_RUNS_ON=["self-hosted","linux","production"]
# Absolute path on the instance for the live compose files (default: ~/medical-diagnostics)
# DEPLOY_PATH=/home/ec2-user/medical-diagnostics
