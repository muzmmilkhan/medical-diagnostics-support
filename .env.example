# Copy to .env and fill in. Used by the backend locally (uv run) and by docker compose.

# --- Required ---
OPENAI_API_KEY=sk-...

# --- Optional: model settings ---
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_TEMPERATURE=0.2

# --- Optional: archive uploaded files in S3 (leave S3_BUCKET_NAME empty to disable) ---
# S3_BUCKET_NAME=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional: app ---
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# MAX_UPLOAD_MB=20
