# Copy this file to .env and fill in your values:  cp .env.example .env

OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible endpoint (leave empty to use the normal OpenAI API)
BASE_URL=

# Optional: save uploaded files to S3 (leave S3_BUCKET_NAME empty to skip)
S3_BUCKET_NAME=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
